# ──────────────────────────────────────────────────────────────
# Dracula CMS — environment configuration
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Appwrite Cloud ────────────────────────────────────────────
# Your region endpoint from Appwrite Console → Settings.
# Examples: https://fra.cloud.appwrite.io/v1 | https://nyc.cloud.appwrite.io/v1
APPWRITE_ENDPOINT=

# Project ID from Appwrite Console → Overview.
APPWRITE_PROJECT_ID=

# API key from Appwrite Console → Overview → Integrations → API keys.
# Create it with the scopes listed in the README (users, sessions, databases,
# collections, attributes, indexes, documents, buckets, files — read+write).
APPWRITE_API_KEY=

# ── This app ──────────────────────────────────────────────────
# Public URL where THIS app is served (no trailing slash).
# Magic-link emails redirect back to:  SITE_URL/auth/verify
# IMPORTANT: the hostname of SITE_URL must also be added as a
# "Web Platform" in the Appwrite console, or magic links will be rejected.
SITE_URL=http://localhost:3000

# ── Appwrite resource IDs (created by `npm run setup`) ────────
APPWRITE_DATABASE_ID=cms
APPWRITE_SITES_COLLECTION_ID=sites
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_BUCKET_ID=sites
