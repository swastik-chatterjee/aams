---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404">
  <section class="mx-auto flex max-w-xl flex-col items-center justify-center px-4 py-24 text-center sm:px-6">
    <p class="text-[11px] text-muted"><span class="text-green">~</span>/error/404</p>
    <h1 class="mt-3 text-5xl font-bold tracking-tight">
      <span class="text-purple">4</span><span class="text-pink">0</span><span class="text-cyan">4</span>
    </h1>
    <p class="mt-5 text-sm leading-relaxed text-muted">
      this page sleeps in a different coffin.
      the URL you tried does not exist — or its site was deleted.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-lg border border-line bg-panel px-5 py-2.5 text-sm text-muted transition hover:border-purple hover:text-fg"
    >
      back to the surface
    </a>
  </section>
</BaseLayout>
