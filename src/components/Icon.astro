---
/**
 * Minimal inline SVG icon set (stroke style, 24×24 grid).
 * Kept local so the project has zero icon dependencies.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className = '' } = Astro.props;

const paths: Record<string, string> = {
